<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_chat" uuid="5C4A7E2B-91D3-4F60-8B1E-2A6F0D9C3E71" library_target="simple_chat">
	<description>simple_chat - a standalone group chat: Eiffel server, Eiffel client, addressable AI and tool participants</description>
	<!-- Phase 1 (contracts). simple_* first: the only ISE library is base (MUTEX is in EiffelBase).
	     EWF is reached only through simple_web; no WSF_* type appears in this project. -->
	<target name="simple_chat">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
			<exclude>/apps$</exclude>
			<exclude>/testing$</exclude>
			<exclude>/dist$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<!-- CONCURRENCY: SCOOP (Larry, Phase 2, 2026-08-29). simple_web serves under SCOOP since 0.2.0
		     (SIMPLE_WEB_HANDLER_SERVER); nothing in this project may rely on threads. -->
		<capability>
			<concurrency support="scoop" use="scoop"/>
			<void_safety support="all"/>
		</capability>
		<!-- ISE allowed -->
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<!-- simple_* -->
		<library name="simple_mml" location="$SIMPLE_EIFFEL/simple_mml/simple_mml.ecf"/>
		<library name="simple_json" location="$SIMPLE_EIFFEL/simple_json/simple_json.ecf"/>
		<library name="simple_datetime" location="$SIMPLE_EIFFEL/simple_datetime/simple_datetime.ecf"/>
		<library name="simple_logger" location="$SIMPLE_EIFFEL/simple_logger/simple_logger.ecf"/>
		<library name="simple_encryption" location="$SIMPLE_EIFFEL/simple_encryption/simple_encryption.ecf"/>
		<library name="simple_uuid" location="$SIMPLE_EIFFEL/simple_uuid/simple_uuid.ecf"/>
		<library name="simple_sql" location="$SIMPLE_EIFFEL/simple_sql/simple_sql.ecf"/>
		<library name="simple_toml" location="$SIMPLE_EIFFEL/simple_toml/simple_toml.ecf">
			<!-- The library's own to_toml writers still call obsolete as_string_8; keep this project's build at zero warnings. -->
			<option warning="none"/>
		</library>
		<library name="simple_process" location="$SIMPLE_EIFFEL/simple_process/simple_process.ecf"/>
		<library name="simple_base64" location="$SIMPLE_EIFFEL/simple_base64/simple_base64.ecf"/>
		<library name="simple_encoding" location="$SIMPLE_EIFFEL/simple_encoding/simple_encoding.ecf"/>
		<library name="simple_http" location="$SIMPLE_EIFFEL/simple_http/simple_http.ecf"/>
		<library name="simple_web" location="$SIMPLE_EIFFEL/simple_web/simple_web.ecf"/>
		<library name="simple_winhttp" location="$SIMPLE_EIFFEL/simple_winhttp/simple_winhttp.ecf"/>
		<library name="simple_ai_client" location="$SIMPLE_EIFFEL/simple_ai_client/simple_ai_client.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_chat_server" extends="simple_chat">
		<root class="SERVER_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<!-- simple_console 1.1.0 carries `read_hidden_line': the three account flags
		     (--create-admin, --create-user, --reset-password) read every password through
		     it, so nothing types back onto a real console. Named on the SERVER target
		     rather than the parent, the way simple_shell and simple_widgets are named on
		     the client's: only apps\server\ uses it, and the client must not
		     grow a dependency it has no call for. -->
		<library name="simple_console" location="$SIMPLE_EIFFEL/simple_console/simple_console.ecf"/>
		<cluster name="server" location=".\apps\server\" recursive="true"/>
	</target>
	<!-- The thick client (intent-v3, D-015): simple_widgets, no browser. The UI-free client stack
	     (CHAT_CLIENT, EVENT_POLLER, CHAT_PRESENTER, ...) lives in the library's src\client\ cluster and is
	     assaulted by the tests target; this target adds the window, the tray and WinHTTP. SHELL_TRAY
	     (simple_shell) and simple_winhttp landed with Phase 4 Task 9; SW_CHAT_VIEW and LOGIN_WINDOW
	     landed with Task 10 over simple_widgets + simple_shaping. Stage the runnable folder with
	     apps/client/stage_client.sh: cairo.dll, LICENSE-ASSETS.md and assets/noto-emoji/png/128. -->
	<target name="simple_chat_client" extends="simple_chat">
		<root class="CLIENT_APP" feature="make"/>
		<setting name="console_application" value="false"/>
		<library name="simple_shell" location="$SIMPLE_EIFFEL/simple_shell/simple_shell.ecf"/>
		<library name="simple_widgets" location="$SIMPLE_EIFFEL/simple_widgets/simple_widgets.ecf">
			<!-- SW_LOCALE.format_number carries an unused local of the library's own; keep this
			     project's build at zero warnings, as simple_toml is kept. -->
			<option warning="none"/>
		</library>
		<cluster name="client" location=".\apps\client\" recursive="true"/>
	</target>
	<target name="simple_chat_tests" extends="simple_chat">
		<root class="TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<!-- Phase 4 Task 9: the wiring assault drives WINHTTP_TRANSPORT, TRAY_NOTIFIER and the
		     client apps cluster headlessly; simple_shell carries SHELL_TRAY for the tray tests.
		     Phase 4 Task 10: simple_widgets joins for SW_CHAT_VIEW and LOGIN_WINDOW - the window
		     assault constructs both OFFSCREEN (SW_WINDOW.make allocates a cairo image surface and
		     nothing native; only `run' creates a window), so the pane's contracts are proven with
		     no desktop. cairo.dll must sit beside the test exe: simple_cairo links an IMPORT
		     library, so a missing DLL is a launch failure, not a degraded run.
		     simple_shaping is named EXPLICITLY beside simple_widgets: an indirectly included
		     library's classes are not in this system's universe, and the window assault reads
		     the SHAPED_LAYOUT the pane's own kit produces for the acceptance line. -->
		<library name="simple_shell" location="$SIMPLE_EIFFEL/simple_shell/simple_shell.ecf"/>
		<library name="simple_shaping" location="$SIMPLE_EIFFEL/simple_shaping/simple_shaping.ecf"/>
		<!-- The tests target compiles apps\server\ too, so it needs what
		     SERVER_APP needs: simple_console, for the no-echo password reads. -->
		<library name="simple_console" location="$SIMPLE_EIFFEL/simple_console/simple_console.ecf"/>
		<library name="simple_widgets" location="$SIMPLE_EIFFEL/simple_widgets/simple_widgets.ecf">
			<!-- SW_LOCALE.format_number carries an unused local of the library's own; keep this
			     project's build at zero warnings, as simple_toml is kept. -->
			<option warning="none"/>
		</library>
		<cluster name="server" location=".\apps\server\" recursive="true"/>
		<cluster name="client" location=".\apps\client\" recursive="true"/>
		<cluster name="tests" location=".\testing\" recursive="true">
			<file_rule>
				<exclude>/doorbell$</exclude>
			</file_rule>
		</cluster>
	</target>
	<!-- The cross-processor doorbell proof (Phase 4 Task 3): one separate CHAT_API owns the
	     service, store and bus; the root plays the request handler - waiters, alarms, a delayed
	     poster and the dispatcher, each on its own SCOOP processor. -->
	<target name="simple_chat_doorbell_tests" extends="simple_chat">
		<root class="DOORBELL_ASSAULT" feature="make"/>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="scoop"/>
		</capability>
		<cluster name="doorbell" location=".\testing\doorbell\" recursive="true"/>
	</target>
</system>
